JWT_SECRET=change-me-to-a-long-random-string-for-local-dev

# Optional: GitHub OAuth (enables "Continue with GitHub" on login)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: Web Push (server + client)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Client: VITE_VAPID_PUBLIC_KEY in .env

# Optional: Cloudflare Calls / Realtime SFU for voice (recommended in production)
# Create an app at https://dash.cloudflare.com/?to=/:account/calls
# CALLS_APP_ID=
# CALLS_APP_SECRET=
