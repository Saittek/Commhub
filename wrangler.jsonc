{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "commhub",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-07-04",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "commhub-db",
      "database_id": "fb37242b-60eb-4c88-81d1-6088ea344e35",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VOICE_ROOM",
        "class_name": "VoiceRoom"
      },
      {
        "name": "TEXT_ROOM",
        "class_name": "TextRoom"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "commhub-attachments"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VoiceRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TextRoom"]
    }
  ]
}
